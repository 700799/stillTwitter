# Twitter / X API credentials (OAuth 1.0a — required for posting tweets)
# Create a project at https://developer.twitter.com and set app permissions to "Read and Write"
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# AI Content Optimizer (optional — powers the ✦ Optimize button on tweet cards)
# Get a free key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email digest (optional — leave blank to skip email sending)
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
DIGEST_EMAIL_TO=recipient@example.com
